# Use "local" to load models from ./models, or "hub" to download from Hugging Face.
MODEL_SOURCE=hub

# Public Hugging Face model repositories
SENTIMENT_MODEL_ID=iiTzAmir21/bilingual-sentiment-model
EMOTION_MODEL_ID=iiTzAmir21/bilingual-emotion-model

# Optional: only needed for private model repositories.
# Never put a real token in this file or commit it to Git.
# HF_TOKEN=

# Optional Hugging Face cache location. Defaults to ~/.cache/huggingface.
# HF_HOME=

# Optional immutable Hugging Face revision (branch, tag, or commit hash).
# HF_REVISION=
